# Copy to GridExpand/.env (or point GRIDEXPAND_ENV_FILE at another file) and adjust values.
# The .env values override variables of the same name in the process environment.
### Database
DB_NAME = "infdb"
DB_USER = "infdb_user"
DB_HOST = "localhost"
DB_PORT = "5432"
DB_PASSWORD = "infdb"
GRID_DATA_PATH="/your/path/to/grid_data"
# Manual Step-1/preparation tools only; scenario runs use run-YAML resources.
PYLOVO_VERSION_ID="1"
### Optional solver settings (defaults: /opt/gurobi1302/linux64 and ~/gurobi.lic if present)
# GUROBI_HOME="/opt/gurobi1302/linux64"
# GRB_LICENSE_FILE="/home/<user>/gurobi.lic"
