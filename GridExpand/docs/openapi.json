    "/api/results/analyses/{analysis_key}/assets": {
      "get": {
        "description": "Building assets of the analysed power-flow runs: one point per building (EPSG:4326)\nwith PV, battery, heat pump, heating rod, heat storage and EV capacities, plus totals\n(``features=false``: totals only).",
        "operationId": "analysis_assets_api_results_analyses__analysis_key__assets_get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_key",
            "required": true,
            "schema": {
              "title": "Analysis Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "plz",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 99999,
                  "minimum": 1,
                  "type": "integer"
                },
                {
