{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PipelineBody": {
        "additionalProperties": false,
        "description": "A synthetic pipeline run for the grids of one region.",
        "properties": {
          "ags": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AGS; resolved from the PLZ when omitted",
            "title": "Ags"
          },
          "candidate_indexes": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "consecutive candidate numbers of the AGS",
            "title": "Candidate Indexes"
          },
          "grid_result_id": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "exactly this pylovo grid (ignores min_buildings)",
            "title": "Grid Result Id"
          },
          "min_buildings": {
            "default": 5,
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Min Buildings",
            "type": "integer"
          },
          "model_cases": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Model Cases",
            "type": "array"
          },
          "plz": {
            "anyOf": [
              {
                "maximum": 99999.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "only the grids of this PLZ",
            "title": "Plz"
          },
          "powerflow_output": {
            "default": "summary",
            "pattern": "^(summary|both)$",
            "title": "Powerflow Output",
            "type": "string"
          },
          "pylovo_version_id": {
            "pattern": "^[\\w.-]{1,10}$",
            "title": "Pylovo Version Id",
            "type": "string"
          },
          "scenario": {
            "description": "file name from GET /api/scenarios",
            "maxLength": 200,
            "minLength": 1,
            "title": "Scenario",
            "type": "string"
          },
          "timeframe_mode": {
            "default": "max_base_electricity_demand_week",
            "title": "Timeframe Mode",
            "type": "string"
          },
          "workers": {
            "default": 1,
            "maximum": 16.0,
            "minimum": 1.0,
            "title": "Workers",
            "type": "integer"
          }
        },
        "required": [
          "pylovo_version_id",
          "scenario"
        ],
        "title": "PipelineBody",
        "type": "object"
      },
      "PreviewBody": {
        "additionalProperties": false,
        "description": "An edited copy of a base scenario: form ``changes`` (dotted keys) on top of ``text`` or the base file.",
        "properties": {
          "base": {
            "description": "file name from GET /api/scenarios",
            "maxLength": 200,
            "minLength": 1,
            "title": "Base",
            "type": "string"
          },
          "base_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "text_sha256 of GET …/form: refuse if the base file changed since",
            "title": "Base Sha256"
          },
          "changes": {
            "additionalProperties": true,
            "description": "dotted YAML path -> value (fields of GET …/form)",
            "maxProperties": 200,
            "title": "Changes",
            "type": "object"
          },
          "file_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "target file name (checked, not written)",
            "title": "File Name"
          },
          "scenario_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "sets scenario.id",
            "title": "Scenario Id"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 200000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "edited YAML text (default: the base file)",
            "title": "Text"
          }
        },
        "required": [
          "base"
        ],
        "title": "PreviewBody",
        "type": "object"
      },
      "SaveBody": {
        "additionalProperties": false,
        "description": "Save the edited copy as ``file_name`` in the user scenario directory.",
        "properties": {
          "base": {
            "description": "file name from GET /api/scenarios",
            "maxLength": 200,
            "minLength": 1,
            "title": "Base",
            "type": "string"
          },
          "base_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "text_sha256 of GET …/form: refuse if the base file changed since",
            "title": "Base Sha256"
          },
          "changes": {
            "additionalProperties": true,
            "description": "dotted YAML path -> value (fields of GET …/form)",
            "maxProperties": 200,
            "title": "Changes",
            "type": "object"
          },
          "file_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "File Name",
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "description": "replace an own file of the same name (a backup is kept)",
            "title": "Overwrite",
            "type": "boolean"
          },
          "scenario_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Scenario Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 200000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "edited YAML text (default: the base file)",
            "title": "Text"
          }
        },
        "required": [
          "base",
          "scenario_id",
          "file_name"
        ],
        "title": "SaveBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Jobs, results and scenario files of GridExpand (load allocation, urbs optimisation, power flow, grid expansion) for the GridPlanner UI. API version 1.",
    "title": "GridExpand API",
    "version": "1",
    "x-api-version": 1
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/grids": {
      "get": {
        "description": "Candidate grids with the runner's numbering (all of the AGS, or one PLZ).",
        "operationId": "grids_api_grids_get",
        "parameters": [
          {
            "in": "query",
            "name": "ags",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ags"
            }
          },
          {
            "in": "query",
            "name": "plz",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 99999,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Plz"
            }
          },
          {
            "in": "query",
            "name": "pylovo_version_id",
            "required": true,
            "schema": {
              "pattern": "^[\\w.-]{1,10}$",
              "title": "Pylovo Version Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "min_buildings",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 100000,
              "minimum": 1,
              "title": "Min Buildings",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Grids Api Grids Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grids",
        "tags": [
          "status"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness probe and contract version (no database access).\n\n``api`` is the contract version of the ``/api`` routes: it changes only with a breaking\nchange, and the GridPlanner UI refuses a major version it does not know.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "status"
        ]
      }
    },
    "/api/jobs": {
      "get": {
        "description": "All jobs (newest first), including the recent history.",
        "operationId": "list_jobs_api_jobs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Jobs Api Jobs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Jobs",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/jobs/pipeline": {
      "post": {
        "description": "Queue ``gridexpand run`` for each selected model case (one after another).",
        "operationId": "start_pipeline_api_jobs_pipeline_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Start Pipeline Api Jobs Pipeline Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Pipeline",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/jobs/terminal": {
      "get": {
        "description": "Runs prepared for a terminal (newest first) with the state of their run directory.",
        "operationId": "terminal_runs_api_jobs_terminal_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Terminal Runs Api Jobs Terminal Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Terminal Runs",
        "tags": [
          "jobs"
        ]
      },
      "post": {
        "description": "Write the run YAML of a request for a run in a terminal (``tmux``) instead of a job.\n\nReturns the YAML, the commands to start and follow it, and a portable copy of the YAML\n(scenario referenced as ``../scenarios/<file>``) for another GridExpand checkout.",
        "operationId": "prepare_terminal_run_api_jobs_terminal_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Prepare Terminal Run Api Jobs Terminal Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Prepare Terminal Run",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "description": "One job with the per-grid status of every step (and the last ``tail`` log lines).",
